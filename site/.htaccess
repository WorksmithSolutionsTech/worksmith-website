# Apache / cPanel rules — generated by src/build.mjs. Edit src/redirects.mjs, not this file.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host: https://worksmith.tech (no www)
RewriteCond %{HTTP_HOST} ^www\.worksmith\.tech$ [NC]
RewriteRule ^(.*)$ https://worksmith.tech/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Page forwarding
# Short links
RewriteRule ^diagnostic/?$ /services/business-health-check/ [R=301,L]
RewriteRule ^health-check/?$ /services/business-health-check/ [R=301,L]
RewriteRule ^intelligence/?$ /services/operational-intelligence-systems/ [R=301,L]
RewriteRule ^automation/?$ /verticals/workflow-automation/ [R=301,L]
RewriteRule ^agents/?$ /services/ai-agent-development/ [R=301,L]
RewriteRule ^whatsapp/?$ /services/whatsapp-communication-automation/ [R=301,L]
RewriteRule ^foundation/?$ /verticals/digital-foundation/ [R=301,L]
RewriteRule ^crm/?$ /services/custom-software-crm-portals/ [R=301,L]
RewriteRule ^apps/?$ /services/mobile-applications/ [R=301,L]
RewriteRule ^analytics/?$ /services/growth-analytics-infrastructure/ [R=301,L]
RewriteRule ^book/?$ /contact/ [R=301,L]
RewriteRule ^scoping/?$ /contact/ [R=301,L]
RewriteRule ^start/?$ /contact/ [R=301,L]
# Common guesses
RewriteRule ^about/?$ /approach/ [R=301,L]
RewriteRule ^about-us/?$ /approach/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^method/?$ /how-we-work/ [R=301,L]
RewriteRule ^process/?$ /how-we-work/ [R=301,L]
RewriteRule ^fees/?$ /pricing/ [R=301,L]
RewriteRule ^security/?$ /data-and-limits/ [R=301,L]
RewriteRule ^verticals/?$ /services/ [R=301,L]
# Legal
RewriteRule ^privacy-policy/?$ /privacy/ [R=301,L]
RewriteRule ^terms-of-use/?$ /terms/ [R=301,L]
RewriteRule ^terms-and-conditions/?$ /terms/ [R=301,L]
RewriteRule ^tos/?$ /terms/ [R=301,L]
RewriteRule ^legal/?$ /privacy/ [R=301,L]
# Legacy file names
RewriteRule ^about\.html/?$ /approach/ [R=301,L]
RewriteRule ^services\.html/?$ /services/ [R=301,L]
RewriteRule ^contact\.html/?$ /contact/ [R=301,L]
RewriteRule ^pricing\.html/?$ /pricing/ [R=301,L]
# Removed service (portfolio 2026, service 04)
RewriteRule ^services/ca-workflow-automation/?$ /verticals/workflow-automation/ [R=301,L]
RewriteRule ^ca-workflow-automation/?$ /verticals/workflow-automation/ [R=301,L]

# Add a trailing slash to page folders
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|js|css|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
